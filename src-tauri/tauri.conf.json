{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Usage Tray",
  "version": "0.1.0",
  "identifier": "com.claudeusagetray.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popup",
        "title": "Claude Usage",
        "url": "index.html",
        "width": 344,
        "height": 500,
        "minWidth": 344,
        "minHeight": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Claude Usage Tray",
    "category": "Utility",
    "shortDescription": "See your remaining Claude Code usage from the Windows tray.",
    "longDescription": "A tiny, on-demand Windows tray utility that reads your local Claude Code session and shows how much of your 5-hour and weekly usage remains, plus a 'Can my prompt finish?' estimator. No polling, no stored secrets.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
